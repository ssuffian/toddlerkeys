{
  "name": "toddlerkeys",
  "productName": "Toddler Keys",
  "version": "0.1.0",
  "description": "An offline keyboard play space for macOS",
  "main": ".vite/build/main.js",
  "private": true,
  "author": "Toddler Keys",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package --platform=darwin --arch=arm64",
    "make": "electron-forge make --platform=darwin --arch=arm64",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "make:mac": "electron-forge make --platform=darwin",
    "release:mac": "./scripts/release-macos.sh",
    "publish:mac": "./scripts/publish-macos.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "electron": "44.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
